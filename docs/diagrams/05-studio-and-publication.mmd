flowchart TB
    account["ACCOUNT actor.roles"] --> gate["InternalApp<br/>hasInternalAccess"]
    gate --> admin["ADMIN<br/>AdminDashboard tại /internal hoặc /internal/admin"]
    gate --> portal["StudioWorkspace<br/>Menu theo getStudioMenu"]
    portal --> edit["EditorPage / EditorCanvas<br/>ScenePanels / draftV2 / storyOps<br/>Sửa: ADMIN hoặc GAME_EDITOR"]
    portal --> reviews["ChaptersPage · /internal/reviews<br/>Duyệt: ADMIN hoặc GAME_REVIEWER<br/>SUBMITTED, khác editorId"]
    portal --> releases["ReleasesPage<br/>Phát hành: ADMIN hoặc GAME_MANAGER<br/>Mọi draft APPROVED, khác editorId"]
    portal --> libraries["AssetsPage / QuestionsPage<br/>Ghi: canEdit hoặc canManage"]
    edit --> client["studioApi → auth.accountRequest<br/>JSON hoặc multipart · Bearer ACCOUNT"]
    reviews --> client
    releases --> client
    libraries --> client
    subgraph API["FinTeen API · ngoài repo"]
        chapters["/api/studio/chapters<br/>Nháp / submit / review / withdraw"]
        releaseApi["/api/studio/releases<br/>next / tạo release / lịch sử / thao tác release"]
        libraryApi["/api/studio/assets<br/>/api/studio/questions"]
        current["/api/content/current<br/>/api/content/releases/{version}/chapters/{code}"]
    end
    client --> chapters
    client --> releaseApi
    client --> libraryApi
    releaseApi -. "Quan hệ phát hành → nội dung công khai<br/>suy luận từ hợp đồng API, chưa kiểm tra backend" .-> current
    game["KidGames → content.api.js<br/>Không token; cache currentRelease trong bộ nhớ"] --> current
    preview["SceneDialogs.PlayDialog<br/>Preview nháp trong Studio"]
    edit --> preview
    classDef core fill:#dbeafe,stroke:#2563eb,color:#172554
    classDef external fill:#f1f5f9,stroke:#64748b,color:#0f172a
